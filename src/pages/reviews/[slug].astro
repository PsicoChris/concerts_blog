---
import Layout from '../../layouts/Layout.astro';
import posts from '../../../posts.json';

export async function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug || post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const resolveImg = (imgUrl?: string) => {
  if (!imgUrl) return '';
  if (imgUrl.startsWith('http://') || imgUrl.startsWith('https://')) return imgUrl;
  const clean = imgUrl.startsWith('/') ? imgUrl.slice(1) : imgUrl;
  return `${baseUrl}${clean}`;
};

const postImg = resolveImg(post.image);
---

<Layout
  title={`${post.title} | Concert Pulse`}
  description={post.description}
  image={post.image}
  ogType="article"
>
  <article class="section section-detail" style="margin-top: 40px;">
    <div class="section-intro">
      <p class="eyebrow">{post.category || "On the road"}</p>
      <h2>{post.title}</h2>
    </div>

    <div class="detail-meta">
      {post.badge && <span class="post-badge">{post.badge}</span>}
      {post.category && <span class="post-category" style="text-transform: capitalize;">{post.category}</span>}
      {post.venue && <span class="post-location">📍 {post.venue}</span>}
      {post.date && <time class="post-date">📅 {post.date}</time>}
    </div>

    {postImg && (
      <div class="detail-image" style={`background-image: url('${postImg}')`}></div>
    )}

    <div class="detail-content">
      {Array.isArray(post.content) ? (
        post.content.map((block: any) => {
          if (typeof block === 'string') {
            return <p>{block}</p>;
          }
          if (block.type === 'heading') {
            return <h3>{block.text}</h3>;
          }
          return <p>{block.text}</p>;
        })
      ) : typeof post.content === 'string' ? (
        <p>{post.content}</p>
      ) : null}
    </div>

    <div style="margin-top: 40px; display: flex; gap: 16px;">
      <a class="button secondary" href={`${baseUrl}#posts`}>← Back to all stories</a>
    </div>
  </article>
</Layout>
